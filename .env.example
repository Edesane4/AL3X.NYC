# AL3X.NYC configuration
# Copy this file to .env and fill in the values.

# Telegram bot — create with @BotFather, then /start your bot and
# get your chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web server
AL3X_HOST=0.0.0.0
AL3X_PORT=8090

# Storage
AL3X_DB_PATH=./al3x.db

# If true, sends a Telegram test message on startup
AL3X_TELEGRAM_TEST_ON_START=true
