# AL3X.NYC configuration
# Copy this file to .env and fill in the values.

# Telegram bot — create with @BotFather, then /start your bot and
# get your chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Claude calibration layer (optional). Gets ~4 API calls/day with 20-minute
# caching ≈ $1/month on claude-sonnet-4-5. Leave blank to disable the AI
# layer; the agent still runs normally.
ANTHROPIC_API_KEY=your-key-here  # ~$1/month at 4 calls/day

# Override the Claude model used for calibration (default: claude-sonnet-4-5).
# AL3X_CLAUDE_MODEL=claude-sonnet-4-5

# Google Sheets auto-export (optional). Leave blank to disable.
#   GOOGLE_SHEETS_SPREADSHEET_ID = the long ID in your sheet's URL
#   GOOGLE_SERVICE_ACCOUNT_JSON  = path to a service-account JSON key file
# (Share the sheet with the service-account email as an Editor.)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Kalshi Market Intelligence (optional — paper mode runs without credentials)
# Create API credentials at: https://kalshi.com/api
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM=

# Set to false only after paper trading validates positive EV
KALSHI_LIVE_TRADING=false
KALSHI_PAPER_MODE=true

# Web server
AL3X_HOST=0.0.0.0
AL3X_PORT=8090

# Storage
AL3X_DB_PATH=./al3x.db

# If true, sends a Telegram test message on startup
AL3X_TELEGRAM_TEST_ON_START=true

# Session 2 — Obsidian vault path for the daily check-in auto-writer
# and correction-cap event notes. Leave blank to disable Obsidian
# integration (all writer calls become no-ops, logged at DEBUG).
# Example: OBSIDIAN_VAULT_PATH=~/Documents/MyVault
OBSIDIAN_VAULT_PATH=
